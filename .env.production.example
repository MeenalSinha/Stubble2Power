# ==============================================================================
# STUBBLE2POWER PRODUCTION ENVIRONMENT TEMPLATE (.env.production.example)
# NEVER commit the actual .env.production file containing live secrets.
# ==============================================================================

# Application Environment (Strict production mode)
APP_ENV=production

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Enterprise PostgreSQL / PostGIS Database Configuration
# In production, SQLite is forbidden; PostgreSQL credentials must be strong
POSTGRES_DB=stubble2power_prod
POSTGRES_USER=stubble_admin
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_CRYPTO_RANDOM_PASSWORD_32_CHARS
DATABASE_URL=postgresql+psycopg2://stubble_admin:REPLACE_WITH_STRONG_CRYPTO_RANDOM_PASSWORD_32_CHARS@db:5432/stubble2power_prod

# NASA FIRMS Earth Observation Key
NASA_FIRMS_MAP_KEY=REPLACE_WITH_VALID_NASA_FIRMS_MAP_KEY
NASA_FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov

# Default Geographic Area of Interest
DEFAULT_AOI_COUNTRY=IND

# Cryptographic Identity & JWT Secrets (MUST be unique 64+ char random string)
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=REPLACE_WITH_UNIQUE_CRYPTOGRAPHIC_JWT_SECRET_KEY_MIN_32_BYTES
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Production Seed Protection (Prevent test/demo accounts in live system)
ALLOW_PRODUCTION_SEED=false
