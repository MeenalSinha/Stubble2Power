# Stubble2Power Environment Configuration Template
# Copy to .env and configure for your environment. Never commit actual secret keys.

# Environment Mode: development | staging | production
APP_ENV=development

# Application Server Host & Port
API_HOST=0.0.0.0
API_PORT=8000

# Database Configuration (PostgreSQL / PostGIS in production, SQLite fallback for local test)
# PostgreSQL example: postgresql://stubble_user:stubble_pass@localhost:5432/stubble2power
DATABASE_URL=sqlite:///./database/stubble2power.db

# NASA FIRMS API MAP_KEY (Request a free MAP_KEY at https://firms.modaps.eosdis.nasa.gov/api/map_key/)
NASA_FIRMS_MAP_KEY=
FIRMS_MAP_KEY=

# NASA FIRMS Base API Endpoint
NASA_FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov

# Default Area of Interest (ISO 3-letter Country code)
DEFAULT_AOI_COUNTRY=IND

# Logging Level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Redis Cache URL (optional for distributed rate limiting & caching)
REDIS_URL=
