# ==============================================================================
# STUBBLE2POWER ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy to .env for local development
# ==============================================================================

# Application Environment (development, staging, production, test)
APP_ENV=development

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Database Connection (SQLite default for dev; PostgreSQL for staging/prod)
DATABASE_URL=sqlite:///./database/stubble2power.db
# DATABASE_URL=postgresql+psycopg2://stubble_user:REPLACE_WITH_SECURE_PASSWORD@localhost:5432/stubble2power

# NASA FIRMS Earth Observation API
# Obtain map key from: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Note: NASA_FIRMS_MAP_KEY and FIRMS_MAP_KEY are aliases and interchangeable across the system.
NASA_FIRMS_MAP_KEY=
# FIRMS_MAP_KEY=
NASA_FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov

# Default Geographic AOI
DEFAULT_AOI_COUNTRY=IND

# Security & Identity (Required in production - generate with: python -c "import secrets; print(secrets.token_urlsafe(64))")
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Backup Encryption & Security (Required for automated encrypted backups)
# Generate key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BACKUP_ENCRYPTION_KEY=

# Seed Data Configuration
ALLOW_PRODUCTION_SEED=false
